Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /perception/final_boxes
      Name: Bus Truck Supplement (green)
      Namespaces: {}
      Queue Size: 1
      Value: true
    - Alpha: 0.15
      Cell Size: 5
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: map
      Value: true
    - Alpha: 0.35
      Buffer Length: 1
      Class: rviz/Path
      Color: 180; 180; 180
      Enabled: true
      Line Style: Lines
      Line Width: 0.18
      Name: Global Path
      Topic: /global_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 90; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.35
      Name: Selected Local Path
      Topic: /local_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lattice/paths
      Name: Lattice Candidates + Ego + Status
      Namespaces:
        candidate_paths_long: true
        candidate_paths_short: true
        ego_shape: true
        lattice_status: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lattice/objects
      Name: Perception Objects (OBB)
      Namespaces:
        lattice_objects: true
        object_lane_labels: true
        predicted_object_obbs: true
        predicted_object_paths: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lattice/lanes
      Name: Active Lane + Roundabout Decisions
      Namespaces:
        highway_lane_centers: true
        highway_lane_labels: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /expert/map
      Name: Course Map + Recorded Reference Paths
      Namespaces: {}
      Queue Size: 1
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /expert/overlays
      Name: Moving VE ROI + Signal Decisions
      Namespaces: {}
      Queue Size: 1
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Color: 255; 255; 0
      Enabled: true
      Keep: 1
      Name: Ego Odometry
      Position Tolerance: 0.1
      Topic: /odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 25; 32
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 140
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Follow Ego
      Pitch: 1.5708
      Target Frame: gps
      Value: XYOrbit (rviz)
      Yaw: 0
    Saved Views:
      - Class: rviz/XYOrbit
        Distance: 1200
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Name: Whole Course
        Pitch: 1.5708
        Target Frame: map
        Value: XYOrbit (rviz)
        Yaw: 0
      - Class: rviz/XYOrbit
        Distance: 140
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Name: Follow Ego
        Pitch: 1.5708
        Target Frame: gps
        Value: XYOrbit (rviz)
        Yaw: 0
Window Geometry:
  Height: 900
  Width: 1500
  X: 50
  Y: 50
