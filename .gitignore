# Downloaded reference checkpoints and sampled CARLA frames. Restore with
# tools/morai/inspect_vision_tokens.py notes; never commit the weights.
VLDrive/.runtime/

# Traffic-label sidecars and evaluation scratch space, rebuilt by
# vision_encoder/tools/build_traffic_labels_v2.py
VLDrive/vision_encoder/.runtime/

# Per-frame capture logs from data collection. Older runs are already tracked;
# new runs stay local because a single manifest can exceed 70 MB.
MoraiDrive/.runtime/sync_runtime/
