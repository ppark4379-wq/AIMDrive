__pycache__/
*.pyc
*.pyo

# Data collection outputs (not code)
MoraiDrive/dataset
MoraiDrive/dataset/
MoraiDrive/dataset_local/
MoraiDrive/.runtime/data_collection/
MoraiDrive/data_collection/routes/generated/
MoraiDrive/data_collection/output/

# VLDrive weights, caches and training runs; see VLDrive/.gitignore for the
# per-folder rules. Rebuild with VLDrive/tools/prepare_assets.py and
# VLDrive/tools/cache_vision_tokens.py.
VLDrive/data/external/
VLDrive/data/raw/
VLDrive/data/processed/vision_tokens/
VLDrive/outputs/checkpoints/
VLDrive/outputs/logs/
VLDrive/.runtime/

# Per-frame capture logs from data collection. Older runs are already tracked;
# new runs stay local because a single manifest can exceed 70 MB.
MoraiDrive/.runtime/sync_runtime/
