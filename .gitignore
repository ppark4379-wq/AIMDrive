__pycache__/
*.pyc
*.pyo

# Data collection outputs (not code)
MoraiDrive/dataset/
MoraiDrive/dataset_local/
MoraiDrive/.runtime/data_collection/
MoraiDrive/data_collection/routes/generated/
MoraiDrive/data_collection/output/
VLDrive/vision_encoder/output_morai/
VLDrive/vision_encoder/.cache/
VLDrive/LAVIS/.runtime/
