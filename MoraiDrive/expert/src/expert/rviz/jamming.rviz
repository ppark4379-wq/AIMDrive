Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Cell Size: 5
      Plane Cell Count: 60
      Color: 80; 80; 80
      Alpha: 0.3
      Reference Frame: map
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Generated Avoidance Path + Ego + Status
      Marker Topic: /lattice/paths
      Queue Size: 1
      Namespaces:
        candidate_paths_recorded: true
        ego_shape: true
        lattice_status: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Obstacles
      Marker Topic: /lattice/objects
      Queue Size: 1
      Namespaces:
        lattice_objects: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 180
      Focal Point:
        X: -25
        Y: -516
        Z: 0
      Name: Jamming Overview
      Pitch: 1.5708
      Target Frame: map
      Value: XYOrbit (rviz)
      Yaw: 0
    Saved Views: {}
Window Geometry:
  Height: 900
  Width: 1500
