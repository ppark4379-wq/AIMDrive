# Downloaded weights (TinyLlama, bert-base-uncased, the official LMDrive
# encoder) and generated caches.  Rebuild with tools/prepare_assets.py,
# tools/cache_vision_tokens.py and tools/build_instructions.py.
/data/external/
/data/raw/
/data/processed/vision_tokens/
/data/processed/navigation_tokens/

# Training runs: checkpoints, logs, metrics, predictions.
/outputs/checkpoints/
/outputs/logs/

# Recorded MORAI captures the offline inference checks read, and the laps the
# collector writes.  Re-recorded from the simulator rather than versioned: one
# campaign here is 8.9 GB.
/data/native_capture/
/data/scenario_campaign_*/

# Reference clone of MORAI-Autonomous/MORAI-NetworkModule, kept beside the
# receivers while the protocols were checked against it.  It carries its own
# .git; re-clone it rather than vendoring it here.
/inference/third_party/

# Local caches (torch hub, Hugging Face, run locks).
/.runtime/

__pycache__/
*.py[cod]
*.pt
*.pth
*.pth.tar
*.log

# Machine-specific Sensor Record transfer paths.
/configs/morai_transfer.local.json
/configs/vision_encoder_sensor_record.local.json
