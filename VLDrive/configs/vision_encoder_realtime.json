{
  "schema": "morai-vision-encoder-realtime-v1",
  "checkpoint": "outputs/checkpoints/checkpoint-best-object.pth.tar",
  "encoder": {
    "lidar_intensity_policy": "reflectance_uint8_unit",
    "note": "checkpoint-best-object.pth.tar has no morai_encoder_contract; measured on the recorded obstacle frames, unit intensity gives peak objectness 0.162 against 0.038 raw, and applying lidar_translation_xyz drops it to 0.031."
  },
  "ports": {
    "rgb_front": 10501,
    "rgb_left": 10502,
    "rgb_right": 10503,
    "rgb_rear": 10504,
    "gps": 10506,
    "imu": 10507,
    "lidar": 2368,
    "vehicle_status": 10909
  },
  "lidar": {
    "axis_policy": "morai_flu_to_lmdrive_fru",
    "elevations": null
  },
  "route": {
    "csv": "data/native_capture/194237_lap_001/route.csv",
    "utm_east_offset": 302595.0,
    "utm_north_offset": 4124145.0
  },
  "runtime": {
    "device": "cuda",
    "bind": "0.0.0.0",
    "target_hz": 20.0,
    "max_age_s": 1.0,
    "startup_timeout_s": 30.0,
    "cpu_threads": 4
  },
  "output": {
    "window": true,
    "panels": [
      "camera",
      "traffic_light",
      "bev_detection",
      "waypoints"
    ],
    "window_columns": 2,
    "window_scale": 1.0,
    "write_files": false,
    "dir": "outputs/logs/realtime",
    "dpi": 130,
    "render_hz": 4.0
  },
  "visualization": {
    "bev_source": "both",
    "detection_threshold": 0.1,
    "show_camera": true,
    "lidar_overlay": true
  }
}
