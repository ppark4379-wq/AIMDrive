{
  "schema": "morai-vision-encoder-train-v1",
  "seed": 42,
  "dataset": {
    "root": "../MoraiDrive/dataset_local/competition_train",
    "split_file": "configs/splits/morai_full_loop_80_20.json",
    "traffic_label_sidecar": null,
    "lidar_axis_policy": "morai_flu_to_lmdrive_fru",
    "train_stride": 1,
    "validation_stride": 1
  },
  "dataloader": {
    "batch_size": 1,
    "workers": 0
  },
  "augmentation": {
    "rgb_hue_jitter": 0.0
  },
  "optimizer": {
    "reference_lr": 0.00075,
    "reference_rgb_lr": 0.0003,
    "weight_decay": 0.05,
    "clip_grad": 5.0
  },
  "schedule": {
    "epochs": 1,
    "warmup_epochs": 0,
    "accumulation_steps": 2,
    "freeze_rgb_epochs": 0
  },
  "loss": {
    "waypoint_weight": 0.5,
    "traffic_light_weight": 0.1
  },
  "output": {
    "dir": "outputs/checkpoints/vision_encoder/smoke",
    "feature_checkpoint": "last",
    "log_interval": 1
  },
  "initialization": {
    "resume": null,
    "warm_start": null,
    "warm_start_sha256": null,
    "warm_start_source_split_sha256": null
  },
  "runtime": {
    "amp": true,
    "max_train_batches": 2,
    "max_validation_batches": 2
  }
}
