{
  "schema": "morai-vision-encoder-inference-v1",
  "checkpoint": "outputs/morai_visual_encoder.pth.tar",
  "dataset": {
    "format": "carla_style",
    "root": "../MoraiDrive/dataset_local/competition_train",
    "split_file": "configs/splits/morai_full_loop_80_20.json",
    "split": "validation",
    "route_csv": null,
    "lidar_axis_policy": "morai_flu_to_lmdrive_fru"
  },
  "frames": {
    "ids": null,
    "stride": 120,
    "limit": 8
  },
  "output": {
    "dir": "outputs/logs/vision_encoder_inference/run1",
    "formats": [
      "pdf",
      "png"
    ],
    "dpi": 200
  },
  "runtime": {
    "device": "cuda",
    "amp": false
  },
  "visualization": {
    "bev_source": "both",
    "detection_threshold": 0.4,
    "show_camera": true
  }
}
