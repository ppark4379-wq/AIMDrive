Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.2
      Cell Size: 20
      Class: rviz/Grid
      Color: 110; 110; 110
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: map
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /vldrive/notice_markers
      Name: Route Notice Zones + Active Instruction
      Namespaces:
        notice_route: true
        notice_zones: true
        notice_start: true
        notice_end: true
        notice_labels: true
        notice_current: true
      Queue Size: 1
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Color: 255; 255; 255
      Enabled: true
      Keep: 1
      Name: Current Vehicle
      Position Tolerance: 0.1
      Topic: /odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 28; 34
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 1250
      Focal Point:
        X: -30
        Y: -100
        Z: 0
      Name: Notice Route Overview
      Pitch: 1.5708
      Target Frame: map
      Value: XYOrbit (rviz)
      Yaw: 1.5708
    Saved:
      - Class: rviz/XYOrbit
        Distance: 60
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Name: Follow Vehicle and Read Notice
        Pitch: 1.5708
        Target Frame: gps
        Value: XYOrbit (rviz)
        Yaw: 0
Window Geometry:
  Height: 900
  Width: 1500
  X: 60
  Y: 60
